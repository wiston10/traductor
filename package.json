{
  "name": "traductor-live",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "start": "cd apps/whisper-server && .venv/bin/python server.py",
    "setup:mlx": "bash tools/convert_to_mlx.sh",
    "bench": "cd apps/whisper-server && .venv/bin/python bench_asr.py",
    "test:server": "cd apps/whisper-server && .venv/bin/python test_server.py",
    "dev:mobile": "npm run start -w @traductor/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npx tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "expo": "~57.0.22"
  }
}
